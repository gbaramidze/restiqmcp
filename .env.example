# Supabase Connection for POS Analytics MCP Server
SUPABASE_URL=https://your-supabase-url.com
SUPABASE_ANON_KEY=your_supabase_anon_or_service_role_key_here

# Optional: Default Tenant ID or Slug (if omitted, uses the first active venue)
# DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# DEFAULT_TENANT_SLUG=ajarapalace

# Optional: HTTP/SSE Server Port (for remote / ChatGPT MCP connections)
MCP_PORT=3005
