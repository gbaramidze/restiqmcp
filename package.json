{
  "name": "@pos/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) Server for POS / Restaurant Analytics and Store Management",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pos-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:sse": "tsx src/sse-server.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js && esbuild src/sse-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/sse-server.js",
    "start": "node dist/index.js",
    "start:sse": "node dist/sse-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  }
}
